# Copy to production.env on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=dental-production
BACKEND_IMAGE=dental-backend:production
FRONTEND_IMAGE=dental-frontend:production
RUNTIME_ENV_FILE=./production.env
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=
JwtSettings__SecretKey=
JwtSettings__Issuer=
JwtSettings__Audience=
JwtSettings__ExpiryMinutes=480
WebPush__VapidPublicKey=
WebPush__VapidPrivateKey=
WebPush__VapidSubject=
Cors__AllowedOrigins__0=https://drsaeedmoghadam.com
Cors__AllowedOrigins__1=https://www.drsaeedmoghadam.com
