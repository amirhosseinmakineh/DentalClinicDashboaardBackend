# Copy to stage.env on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=dental-stage
BACKEND_IMAGE=dental-backend:stage
FRONTEND_IMAGE=dental-frontend:stage
RUNTIME_ENV_FILE=./stage.env
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=3001

ASPNETCORE_ENVIRONMENT=Stage
ConnectionStrings__DefaultConnection=
JwtSettings__SecretKey=
JwtSettings__Issuer=
JwtSettings__Audience=
JwtSettings__ExpiryMinutes=480
WebPush__VapidPublicKey=
WebPush__VapidPrivateKey=
WebPush__VapidSubject=
Cors__AllowedOrigins__0=https://stage.drsaeedmoghadam.com
