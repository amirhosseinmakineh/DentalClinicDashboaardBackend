<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FrameworkPackageVersion Condition="'$(FrameworkPackageVersion)' == ''">1.0.0</FrameworkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DentalDashboard.Framwork\DentalDashboard.Framwork.csproj" Condition="'$(UsePrivateFrameworkPackage)' != 'true'" />
    <PackageReference Include="DentalDashboard.Framework" Version="$(FrameworkPackageVersion)" Condition="'$(UsePrivateFrameworkPackage)' == 'true'" />
  </ItemGroup>

</Project>
