# Copy to develop.env on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=dental-develop
BACKEND_IMAGE=dental-backend:develop
FRONTEND_IMAGE=dental-frontend:develop
RUNTIME_ENV_FILE=./develop.env
BACKEND_HOST_PORT=8082
FRONTEND_HOST_PORT=3002

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=
JwtSettings__SecretKey=
JwtSettings__Issuer=
JwtSettings__Audience=
JwtSettings__ExpiryMinutes=480
WebPush__VapidPublicKey=
WebPush__VapidPrivateKey=
WebPush__VapidSubject=
Cors__AllowedOrigins__0=http://localhost:3002
